# URL сервера клиента (Node.js + Express, интегрирован с Bitrix24)
# Apache на сервере проксирует /bitrix → 127.0.0.1:9002/bitrix
VITE_API_BASE_URL=https://minitest.bitrixabd.ru/bitrix

# Корневой URL сервера для /inventory/... эндпоинтов.
# Если не задан — вычисляется как VITE_API_BASE_URL без сегмента /bitrix.
# Пример: https://minitest.bitrixabd.ru
VITE_SERVER_BASE_URL=

# ID пользователя для отладки вне Telegram (подставляется в заголовок X-Debug-User-Id)
VITE_DEBUG_USER_ID=
